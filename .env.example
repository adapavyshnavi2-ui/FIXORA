# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxx
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo
GITHUB_BASE_BRANCH=Dev

# --- Telegram ---
TELEGRAM_BOT_TOKEN=xxxx:yyyy
TELEGRAM_CHAT_ID=123456789

# --- Webhook server (receives Vercel/Railway deploy logs) ---
PORT=3000
WEBHOOK_SECRET=change-me

# --- Pipeline tuning ---
NUM_CANDIDATES=3
AUTO_MERGE_CONFIDENCE_THRESHOLD=0.85
MAX_REVIEW_RETRIES=2

# --- Local repo working copy (cloned/worktree used for sandboxed test runs) ---
LOCAL_REPO_PATH=./workspace/repo
